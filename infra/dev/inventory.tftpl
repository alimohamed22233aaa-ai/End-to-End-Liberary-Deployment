[master]
master-node ansible_host=${master_ip}

[workers]
worker-node-1 ansible_host=${worker1_ip}
worker-node-2 ansible_host=${worker2_ip}

[k8s:children]
master
workers

[k8s:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/ali-mohamed.pem
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o ProxyCommand="ssh -W %h:%p -o StrictHostKeyChecking=no -i ~/.ssh/ali-mohamed.pem ubuntu@${bastion_ip}"'